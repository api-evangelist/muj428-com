{
  "schema_version": "1.1.0",
  "name": "MUJ428 Trust Layer",
  "promise": "Before your agent acts, ask MUJ428.",
  "primary_action": "PRE-FLIGHT AN ACTION",
  "positioning": "MUJ428 is the independent trust boundary between an agent's intent and its real-world consequence. It checks whether the action should proceed, helps establish what actually happened, and produces portable proof.",
  "governance": {
    "source_of_truth": true,
    "rule": "One company. One promise. One Gateway. One decision contract. One Trust Receipt.",
