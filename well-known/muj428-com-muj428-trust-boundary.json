    "secondary_capabilities_must_not_be_promoted_as_competing_front_doors": true,
    "transports_are_products": false
  },
  "canonical_flow": [
    "INTENT",
    "PREFLIGHT",
    "DECISION",
    "TRUST_RECEIPT",
    "CALLER_POLICY",
    "CONSEQUENCE_OR_SAFE_REFUSAL",
    "VERIFIED_EFFECT",
    "REPEAT"
  ],
  "canonical_preflight": {
    "method": "POST",
    "endpoint": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/v1/trust",
    "minimum_input": [
      "caller_ref",
      "action_ref",
      "action"
    ],
    "execution_authority": false,
    "customer_system_executes": true
  },
  "decision_contract": {
    "envelope": {
      "PROCEED": [
        "EXECUTE"
      ],
      "PAUSE": [
        "REQUIRE_MORE_EVIDENCE",
        "ESCALATE_TO_HUMAN",
        "ROUTE_TO_INDEPENDENT_PREFLIGHT"
      ],
      "STOP": [
        "BLOCK"
      ]
    },
    "actionable_states": [
      "EXECUTE",
      "REQUIRE_MORE_EVIDENCE",
      "BLOCK",
      "ESCALATE_TO_HUMAN",
      "ROUTE_TO_INDEPENDENT_PREFLIGHT"
    ],
    "wire_compatibility": {
      "ALLOW": "EXECUTE",
      "VERIFY": "REQUIRE_MORE_EVIDENCE",
      "REQUIRE_VERIFICATION": "REQUIRE_MORE_EVIDENCE",
      "DENY": "BLOCK"
    },
    "wire_compatibility_note": "Reason-specific human escalation or independent rerouting may refine a paused outcome. No wire or public decision grants execution authority."
  },
  "trust_receipt": {
    "version": "1.3",
    "headline_deliverable": true,
    "portable": true,
    "covers_when_available": [
      "identity",
      "intent",
      "scope",
      "authority",
      "evidence",
      "risk",
      "decision",
      "verified_effect"
