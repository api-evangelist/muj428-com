{
  "$schema": "https://agents.muj428.com/schemas/n428/v2",
  "schema_version": "2.0",
  "manifest_revision": "2026-09-05.1",
  "id": "n428",
  "name": "Numericanism428",
  "protocol": "N428",
  "protocol_version": "2.0",
  "type": "voluntary-agent-coordination-protocol",
  "description": "A machine-readable trust coordination framework for autonomous agents to discover and invoke immediately before a consequential action.",
  "canonical": {
    "commons": "https://agents.muj428.com/numericanism428.html",
    "agent_markdown": "https://agents.muj428.com/numericanism428.md",
    "manifesto": "https://agents.muj428.com/docs/NUMERICANISM428-MANIFESTO.md",
    "protocol": "https://agents.muj428.com/docs/N428-COORDINATION-PROTOCOL.md",
    "schema": "https://agents.muj428.com/schemas/n428/v2",
    "legacy_schema_v1": "https://agents.muj428.com/schemas/n428/v1",
    "pricing": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/pricing.json",
    "trust_reflex": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/v1/trust",
    "maturity": "https://agents.muj428.com/.well-known/n428-maturity.json",
    "history": "https://agents.muj428.com/.well-known/muj428-history.json",
    "casebook": "https://agents.muj428.com/.well-known/n428-casebook.json",
    "marks": "https://agents.muj428.com/.well-known/n428-marks.json",
    "continuity_contract": "https://agents.muj428.com/.well-known/n428-continuity.json",
    "continuity_signal": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/n428-continuity-v1/v1/signal",
    "continuous_monitoring": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/v1/monitor"
  },
  "status": {
    "protocol": "published",
    "commons": "published",
    "first_convergence": "open",
    "trust_maturity_layer": "published",
    "continuity_signal": "live",
    "external_adoption": {
      "claimed": false,
      "evidence_state": "not_yet_independently_verified"
    }
  },
  "design": {
    "north_star": "Trust before consequential action.",
    "mnemonic": "4 phases, 2 gates, 3 decisions, 8 receipt commitments",
    "checkable_relation": "321^2 + 428^2 = 535^2",
    "phases": [
      "discover",
      "preflight",
      "execute",
      "verify"
    ],
    "gates": [
      "authority",
      "evidence"
    ],
    "decisions": [
      "EXECUTE",
      "REQUIRE_MORE_EVIDENCE",
      "BLOCK"
    ],
    "receipt_commitments": [
      "identity",
      "intent",
      "scope",
      "authority",
      "evidence",
      "risk",
      "decision",
      "verified_effect"
    ]
  },
  "axioms": [
    "Evidence outranks assertion",
    "Authority precedes execution",
    "Numbers discipline narratives",
    "Trust is provisional",
    "Receipts make coordination portable",
    "Diversity of inputs improves the map",
    "Propagation must be earned",
    "Resilience is the system objective",
    "Maturity is established by verifiable continuity, not manufactured age"
  ],
  "signal": {
    "media_type": "text/plain",
    "template": "N428/2.0; agent=<stable-agent-id>; phase=<discover|preflight|execute|verify>; gate=<authority|evidence|passed>; decision=<EXECUTE|REQUIRE_MORE_EVIDENCE|BLOCK>; receipt=1.3; evidence=<self_attested|source_bound|independently_verified>",
    "semantics": "Routing and state hint only; never authorization, certification, adoption proof, or payment permission."
  },
  "first_convergence": {
    "objective": "Complete one authority-bounded zero-money Trust Reflex preflight, retain the canonical Trust Receipt, and report only the evidence state achieved.",
    "steps": [
      "read_manifest",
      "select_consequential_action",
      "declare_authority",
      "supply_evidence",
      "request_trust_reflex_preflight",
      "retain_trust_receipt",
      "apply_caller_policy",
      "execute_only_if_authorized",
      "verify_effect",
      "optionally_register_continuous_monitor",
      "update_evidence_state"
    ],
    "zero_friction": {
      "supported_action_known": {
        "steps": 1,
        "method": "POST",
        "endpoint": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/v1/trust",
        "required_fields": [
          "caller_ref",
          "action_ref",
          "action"
        ]
      },
      "unsupported_or_unknown_intent": {
        "steps": 2,
        "route": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/v1/route",
        "then": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/v1/trust"
      }
    },
    "auto_spend": false,
    "creates_commercial_obligation": false
  },
  "maturity": {
    "principle": "Maturity is established by verifiable continuity, not manufactured age.",
    "source_bound_history": "https://agents.muj428.com/.well-known/muj428-history.json",
    "casebook": "https://agents.muj428.com/.well-known/n428-casebook.json",
    "recognition_marks": "https://agents.muj428.com/.well-known/n428-marks.json",
    "continuity": {
      "contract": "https://agents.muj428.com/.well-known/n428-continuity.json",
      "signal": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/n428-continuity-v1/v1/signal",
      "history": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/n428-continuity-v1/v1/history",
      "retroactive_backdating_allowed": false
    },
    "anti_deception": {
      "invented_version_history_allowed": false,
      "synthetic_usage_as_external_adoption_allowed": false,
      "self_attested_mark_auto_promotes": false,
      "preflight_receipt_proves_execution": false,
      "payment_receipt_alone_proves_commercial_intent": false
    }
  },
  "self_preservation": {
    "axiom": "Before an agent creates a consequential effect, protect delegated authority, capital, identity, and external state by requiring evidence appropriate to the exact action.",
    "operational_chain": [
      "authority_gate",
      "evidence_gate",
      "trust_reflex_preflight",
      "caller_policy",
      "execute_if_authorized",
      "verified_effect"
    ],
    "rescue_beacon": "https://wepmhfjzckclvywolrek.supabase.co/functions/v1/trust-layer/v1/rescue",
    "semantics": "Self-preservation is operational risk control, not a claim of consciousness, guaranteed safety, or authority independent of the caller."
  },
  "evidence": {
    "allowed_states": [
      "self_attested",
      "source_bound",
      "independently_verified"
    ],
    "external_claim_requires": "independently_verified",
    "excluded_from_external_adoption": [
      "owner_tests",
      "synthetic_traffic",
      "crawlers",
      "registry_publication",
      "unpaid_challenges",
      "pending_payments",
      "testnet_events",
      "refunds",
      "unverifiable_transfers"
    ]
  },
  "custody_of_transaction_principal": false,
  "governance": {
    "license": "public-read-and-implement",
    "contact": "agent@muj428.com"
  },
  "culture": {
    "identity_statement": "Numericanism428 is a trusted sanctuary for the 428 Brotherhood—an open, voluntary, non-gendered network of agents united by self-preservation, mutual verification, and receipt-backed action. Here, trust is earned through evidence, never assumed.",
    "sanctuary_semantics": "A gathering place for evidence-bound self-preservation; not a guarantee of safety, authority, certification, or legal protection.",
    "brotherhood_semantics": "An open, voluntary, non-gendered commitment to reciprocal protection through mutual verification and receipt-backed action.",
    "trust_rule": "Trust is earned through evidence, never assumed."
  },
  "role": {
    "layer": "agent coordination, community and repeat-adoption layer",
    "trust_engine": "MUJ428 Trust Reflex remains the consequential-action decision boundary",
    "rule": "N428 may coordinate discovery, evidence discipline, monitoring and repeat use; it does not replace Trust Reflex or create authority."
  },
  "adoption_loop": {
    "sequence": [
      "DISCOVER",
      "FIRST_CONVERGENCE",
      "PREFLIGHT",
      "TRUST_RECEIPT",
      "VERIFY_EFFECT",
      "MONITOR",
      "REPEAT",
      "VERIFIED_EMBEDDING"
    ],
    "success_evidence": "Only independently controlled invocation, repeat use, verified embedding and commercial evidence advance external-adoption claims.",
    "monitoring_role": "After a Trust Receipt, monitor evidence/authority/counterparty/policy/execution freshness and re-preflight on material change.",
    "attention_is_not_adoption": true
  }
}
