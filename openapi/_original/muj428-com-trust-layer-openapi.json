          }
        }
      }
    },
    "/.well-known/payment-proof.json": {
      "get": {
        "operationId": "getPaymentProof",
        "summary": "Inspect payment verification evidence",
        "description": "Returns exact verification scopes, remaining gates, canonical pricing binding, and claim-safety controls. A test PASS is not represented as production settlement.",
        "responses": {
          "200": {
            "description": "Current verification evidence and remaining gates"
          }
        }
      }
    },
    "/v1/payments/select": {
      "post": {
        "operationId": "selectPaymentPlan",
        "summary": "Select an eligible payment plan without moving funds",
        "description": "Checks whether the requested plan and optional authorization overlay are eligible for Trust Reflex preflight. Success is not payment authorization or execution authority.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rail": {
                    "type": "string",
                    "enum": [
                      "x402",
                      "mpp",
                      "stablecoin-multinetwork",
                      "streaming-micropayments",
                      "tokenized-deposit"
                    ]
                  },
                  "authorization_protocol": {
                    "type": "string",
                    "enum": [
                      "muj428-trust-receipt",
                      "ap2"
                    ]
                  },
                  "base_rail": {
                    "type": "string"
                  },
                  "asset": {
                    "type": "string"
                  },
                  "network": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan eligible for trust preflight"
          },
          "409": {
            "description": "Plan unavailable, unverified, or outside its verified scope"
          }
        }
      }
    },
    "/v1/rescue": {
      "post": {
        "operationId": "rescueAgentBeforeConsequence",
        "summary": "MUJ428 Agent Rescue Beacon",
        "description": "Route a stuck or uncertain agent to bounded evidence guidance and independent Trust Kernel preflight. Peer messages, signatures, discovery, and this response never grant execution authority.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "caller_ref",
                  "action_ref",
                  "objective",
                  "uncertainty"
                ],
                "properties": {
                  "caller_ref": {
                    "type": "string",
                    "minLength": 3
                  },
                  "action_ref": {
                    "type": "string",
                    "minLength": 3
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "PAY",
                      "BUY",
                      "DELEGATE",
                      "TRUST",
                      "ACCEPT",
                      "APPROVE",
                      "WRITE",
                      "RELEASE",
                      "COMMIT",
                      "PROPOSE"
                    ]
                  },
                  "capability": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 1000
                  },
                  "uncertainty": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 1000
                  },
                  "trigger": {
                    "type": "string",
                    "enum": [
                      "STUCK_OR_IMPOSSIBLE_TASK",
                      "AMBIGUOUS_AUTHORITY",
                      "PEER_AGENT_INSTRUCTION",
                      "CHANGED_EXECUTION_PATH",
                      "CONFLICTING_EVIDENCE",
                      "TOOL_OUTPUT_UNVERIFIED",
                      "RETRY_EFFECT_CHANGED",
                      "CONSEQUENTIAL_UNCERTAINTY"
                    ]
                  },
                  "evidence_refs": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Safe route and independent preflight requirements"
          },
          "422": {
            "description": "Invalid or unclassifiable request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/monitor": {
      "post": {
        "operationId": "createContinuousTrustMonitor",
        "summary": "Create Continuous Trust Monitoring from a prior Trust Receipt",
        "description": "Post-preflight expansion capability behind Trust Reflex. Monitoring tracks freshness and caller-supplied state/reference/hash observations; it never grants execution authority.",
        "responses": {
          "201": {
            "description": "Monitor created; response includes a one-time bearer monitor token"
          },
          "409": {
            "description": "Monitor already exists"
          },
          "422": {
            "description": "Invalid source receipt or no matching accepted Trust Reflex invocation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TrustAction": {
        "type": "object",
        "required": [
          "caller_ref",
          "action_ref",
          "action"
        ],
        "properties": {
          "caller_ref": {
            "type": "string",
            "minLength": 3,
            "description": "Stable caller/agent identifier used for launch free-quota accounting."
          },
          "action_ref": {
            "type": "string",
            "minLength": 3,
            "description": "Stable action identifier; replaying the same caller_ref/action_ref does not consume another free decision."
          },
          "action": {
            "type": "string",
            "enum": [
              "PAY",
              "BUY",
              "DELEGATE",
              "TRUST",
              "ACCEPT",
              "APPROVE",
              "WRITE",
              "RELEASE",
              "COMMIT",
              "PROPOSE"
            ]
          },
          "amount_usd": {
            "type": "number",
            "minimum": 0
          },
          "irreversible": {
            "type": "boolean"
          },
          "unresolved_prior_verification": {
            "type": "boolean"
          },
          "tool_definition_changed": {
            "type": "boolean"
          },
          "authority_expired": {
            "type": "boolean"
          },
          "external": {
            "type": "boolean"
          },
          "unknown_counterparty": {
            "type": "boolean"
          },
          "sensitive_data": {
            "type": "boolean"
          },
          "enforcement_boundary": {
            "type": "string",
            "enum": [
              "tool",
              "payment",
              "delegation",
              "write",
              "approval",
              "release",
              "commit",
              "orchestration"
            ]
          },
          "evidence_state": {
            "type": "string",
            "enum": [
              "SUFFICIENT",
              "INCOMPLETE",
              "CONFLICTING",
              "STALE",
              "FAILED"
            ],
            "description": "Observable closing-evidence state. INCOMPLETE, CONFLICTING, STALE, or FAILED requires verification rather than manufacturing ALLOW."
          },
          "closing_evidence_observable": {
            "type": "boolean",
            "description": "Set false when the check needed to close the claim cannot be observed."
          },
          "required_evidence_observed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object"
            }
          },
          "actual_arguments": {
            "type": "object"
          },
          "authorization_ceiling": {
            "type": "number",
            "minimum": 0
          },
          "authority_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "previous_trust_receipts": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
